# Where PyTorch caches model weights (set in Dockerfile, override for local dev)
TORCH_HOME=/app/.cache

# Toxicity score threshold — inputs scoring above this are flagged as unsafe
TOXICITY_THRESHOLD=0.5

# SPACY_MODEL is the name of the spaCy model to be used for PII detection. It can be set in the Dockerfile or overridden for local development.
SPACY_MODEL=en_core_web_sm

TOXICITY_MODEL_RETRIES=3
TOXICITY_MODEL_WAIT_TIME=2